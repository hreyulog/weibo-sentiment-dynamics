 RowBox[{
  RowBox[{
   RowBox[{"solveDG", " ", "=", " ", 
    RowBox[{"NMinimize", "[", "\n", "\[NonBreakingSpace]\[NonBreakingSpace] ", 
     RowBox[{
      RowBox[{
      "{", "\n", "\[NonBreakingSpace]\[NonBreakingSpace]\[NonBreakingSpace] ", 
       RowBox[{
        RowBox[{"Sum", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
