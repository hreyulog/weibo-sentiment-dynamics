  RowBox[{"Mean", "[", 
   RowBox[{"Mean", "[", 
    RowBox[{"Abs", "[", 
     RowBox[{
      RowBox[{"XEPO", "[", 
       RowBox[{"[", 
        RowBox[{"1", ";;", "10"}], "]"}], "]"}], "-", 
      RowBox[{"X", "[", 
       RowBox[{"[", 
        RowBox[{"1", ";;", "10"}], "]"}], "]"}]}], "]"}], "]"}], 
   "]"}]}], "\n", 
